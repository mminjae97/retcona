# --- DB (10.5.4: 코드는 항상 DATABASE_URL 하나만 알면 됨) ---
DATABASE_URL=postgresql://retcona:retcona@localhost:5432/retcona

# --- 인증 (3.1, 3.3) ---
JWT_SIGNING_KEY=
JWT_ENCRYPTION_KEY=
PASSWORD_HASH_SCHEME=bcrypt

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=

# --- 인프라 추상화 (10.4.3) — cpu|gpu, external|self_hosted 로 백엔드 전환 ---
INFERENCE_BACKEND=cpu
LLM_PROVIDER=external
LLM_API_KEY=
LLM_MODEL=

QUEUE_PROVIDER=redis
# 로컬 개발: redis / 운영(GCP): pubsub
REDIS_URL=redis://localhost:6379/0

STORAGE_PROVIDER=local
# 로컬 개발: local / 운영(GCP): gcs
GCS_BUCKET=

# --- 워커 (10.4.4) ---
WORKER_TYPE=cpu
