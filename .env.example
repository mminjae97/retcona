# --- DB (10.1) ---
# A SQLite file, created and upgraded by the app at startup. Empty means the
# app's own: %LOCALAPPDATA%\Retcona\retcona.db (elsewhere than Windows,
# ~/.local/share/retcona/retcona.db). Another file, by its full path:
# sqlite:///C:/path/to/file.db — it's a URL, so a %, ? or # in the path is
# written %25, %3F, %23.
DATABASE_URL=

# --- Infra abstraction (10.4.3) — switch backend via cpu|gpu, external|self_hosted ---
# NLI for the appearance/location judgment runs in the CPU worker (cpu; gpu
# isn't wired up yet). The model is the one trained in ml/nli (see its README),
# kept locally for now: empty NLI_MODEL means ml/nli/runs/mixed. Without that
# directory the worker falls back to Huffon/klue-roberta-base-nli (downloaded
# from Hugging Face, ~440 MB; weaker on novel prose) and logs a warning.
# NLI_MODEL: another local directory (an absolute path — the worker runs from
# backend/) or Hugging Face checkpoint.
INFERENCE_BACKEND=cpu
NLI_MODEL=
# Claim extraction (7.1.1) runs the NER and extractive QA models trained in
# ml/ner and ml/qa, also kept locally for now: empty NER_MODEL / QA_MODEL mean
# ml/ner/runs/klue and ml/qa/runs/klue. There's no public fallback; without
# them extraction fails. Another local directory (an absolute path) or Hugging
# Face checkpoint can be given the same way as NLI_MODEL.
NER_MODEL=
QA_MODEL=
# The LLM (chapter 5; model not chosen yet) is used for OOC judgment only;
# claim extraction doesn't use one (7.1.1).
# LLM_MODEL_JUDGMENT: OOC judgment (a strong model)
# LLM_PROVIDER: mock is a development stand-in with no model that judges
# nothing (backend/infra/mock_llm.py); external / self_hosted aren't wired up
# yet.
# LLM_ENDPOINT: the self_hosted server.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL_JUDGMENT=
LLM_ENDPOINT=

STORAGE_PROVIDER=local
# Local dev: local / Production (GCP): gcs
GCS_BUCKET=
