# --- DB (10.1) ---
# A SQLite file, created and upgraded by the app at startup. Empty means the
# app's own: %LOCALAPPDATA%\Retcona\retcona.db (elsewhere than Windows,
# ~/.local/share/retcona/retcona.db). Another file, by its full path:
# sqlite:///C:/path/to/file.db — it's a URL, so a %, ? or # in the path is
# written %25, %3F, %23.
DATABASE_URL=

# --- Infra abstraction (10.4.3) ---
# The NLI, NER and QA models run with ONNX Runtime (10.3): on the GPU through
# DirectML where one works, else on the CPU, with the same results.
# INFERENCE_DEVICE: auto (the default) | gpu | cpu — cpu never tries the GPU.
INFERENCE_DEVICE=auto
# The models are the ones trained in ml/nli, ml/ner and ml/qa, exported to ONNX
# with ml/export_onnx.py (into the run's onnx/), and kept locally for now:
# empty means ml/nli/runs/mixed, ml/ner/runs/klue and ml/qa/runs/klue. Another
# one: its directory (an absolute path — the backend runs from backend/),
# exported or a run with an onnx/ in it. There's no public fallback yet;
# without the NLI model nothing is judged, without NER and QA nothing is
# extracted.
NLI_MODEL=
NER_MODEL=
QA_MODEL=
# The LLM (chapter 5; model not chosen yet) is used for OOC judgment only;
# claim extraction doesn't use one (7.1.1).
# LLM_MODEL_JUDGMENT: OOC judgment (a strong model)
# LLM_PROVIDER: mock is a development stand-in with no model that judges
# nothing (backend/infra/mock_llm.py); external / self_hosted aren't wired up
# yet.
# LLM_ENDPOINT: the self_hosted server.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL_JUDGMENT=
LLM_ENDPOINT=

STORAGE_PROVIDER=local
# Local dev: local / Production (GCP): gcs
GCS_BUCKET=
