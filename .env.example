# --- DB (10.5.4: the code only ever needs to know DATABASE_URL) ---
DATABASE_URL=postgresql+psycopg://retcona:retcona@localhost:5432/retcona
# Connections give up after 10 seconds by default (startup, requests, the purge).
# Override with ?connect_timeout=N in DATABASE_URL, or a positive libpq
# PGCONNECT_TIMEOUT (an empty, 0 or non-numeric value there is ignored). With
# psycopg 3, connect_timeout=0 doesn't mean "no timeout": it falls back to 130 s.

# --- Auth (3.1, 3.3) ---
# HMAC secret for the inner JWT (JWS). Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SIGNING_KEY=
# 32-byte (256-bit) key for the outer JWE (dir + A256GCM), hex-encoded.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_ENCRYPTION_KEY=
PASSWORD_HASH_SCHEME=bcrypt

# Google login (3.2), the only social login. A "Web application" OAuth client
# from Google Cloud Console (APIs & Services > Credentials); add the redirect URI
# below to its "Authorized redirect URIs" exactly as written here. Leave these
# empty to turn Google login off (the button stays disabled).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# The frontend's callback page: <frontend origin>/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/google/callback

# --- Infra abstraction (10.4.3) — switch backend via cpu|gpu, external|self_hosted ---
INFERENCE_BACKEND=cpu
LLM_PROVIDER=external
LLM_API_KEY=
LLM_MODEL=

QUEUE_PROVIDER=redis
# Local dev: redis / Production (GCP): pubsub
REDIS_URL=redis://localhost:6379/0

STORAGE_PROVIDER=local
# Local dev: local / Production (GCP): gcs
GCS_BUCKET=

# --- Worker (10.4.4) ---
WORKER_TYPE=cpu

# --- Account purge (3.5) ---
# The API server permanently deletes accounts past their 30-day deletion grace
# period once a day, at midnight in PURGE_TIMEZONE (an IANA name). PURGE_ENABLED=0
# turns that off, e.g. if `python -m workers.purge` runs separately.
PURGE_ENABLED=1
PURGE_TIMEZONE=Asia/Seoul
